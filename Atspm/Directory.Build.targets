<Project>

  <!--
    Explicit OpenAPI export used by WebUI's `npm run sync:api` command.
    Ordinary builds do not export specs. To export one API directly, restore
    tools in Atspm, then run `dotnet msbuild -restore -target:ExportSwaggerSpec`
    from its project directory. SwaggerSpecName opts API projects into export;
    SwaggerSpecOutputDir can point at a temporary staging directory.

    The CLI version comes from Atspm/.config/dotnet-tools.json. Missing tools
    and failed exports are errors so a sync cannot silently use stale specs.

    Export stays in Development and sets ATSPM_SWAGGER_EXPORT only in its child
    process to suppress configuration dumps. In-memory database settings and
    disabled migrations allow export without a running database.
  -->
  <PropertyGroup Condition="'$(SwaggerSpecName)' != ''">
    <SwaggerToolManifest>$(MSBuildThisFileDirectory).config\dotnet-tools.json</SwaggerToolManifest>
    <SwaggerCliVersion Condition="Exists('$(SwaggerToolManifest)')">$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('$(SwaggerToolManifest)')), '(?s).*"swashbuckle\.aspnetcore\.cli"\s*:\s*\{\s*"version"\s*:\s*"([^"]+)".*', '$1'))</SwaggerCliVersion>
    <SwaggerCliDll>$(NuGetPackageRoot)swashbuckle.aspnetcore.cli\$(SwaggerCliVersion)\tools\$(TargetFramework)\any\dotnet-swagger.dll</SwaggerCliDll>
    <SwaggerSpecOutputDir Condition="'$(SwaggerSpecOutputDir)' == ''">$(MSBuildProjectDirectory)</SwaggerSpecOutputDir>
    <SwaggerSpecOutput>$([System.IO.Path]::Combine('$(SwaggerSpecOutputDir)', '$(SwaggerSpecName)-spec.json'))</SwaggerSpecOutput>
  </PropertyGroup>

  <Target Name="ExportSwaggerSpec" DependsOnTargets="Build">
    <Error Condition="'$(SwaggerSpecName)' == ''"
           Text="OpenAPI export is not configured for $(MSBuildProjectName): SwaggerSpecName is required." />
    <Error Condition="!Exists('$(SwaggerCliDll)')"
           Text="OpenAPI export failed for $(MSBuildProjectName): Swashbuckle CLI '$(SwaggerCliVersion)' not found at '$(SwaggerCliDll)'. Run 'dotnet tool restore' in $(MSBuildThisFileDirectory)." />
    <MakeDir Directories="$(SwaggerSpecOutputDir)" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="dotnet exec --depsfile &quot;$(TargetDir)$(TargetName).deps.json&quot; --runtimeconfig &quot;$(TargetDir)$(TargetName).runtimeconfig.json&quot; &quot;$(SwaggerCliDll)&quot; tofile --output &quot;$(SwaggerSpecOutput)&quot; &quot;$(TargetPath)&quot; v1"
          EnvironmentVariables="DOTNET_ENVIRONMENT=Development;ASPNETCORE_ENVIRONMENT=Development;ATSPM_SWAGGER_EXPORT=true;DatabaseConfiguration__ConfigContext__DBType=InMemory;DatabaseConfiguration__ConfigContext__Host=localhost;DatabaseConfiguration__ConfigContext__Database=swagger-export;DatabaseConfiguration__ConfigContext__RunMigrations=false;DatabaseConfiguration__AggregationContext__DBType=InMemory;DatabaseConfiguration__AggregationContext__Host=localhost;DatabaseConfiguration__AggregationContext__Database=swagger-export;DatabaseConfiguration__AggregationContext__RunMigrations=false;DatabaseConfiguration__EventLogContext__DBType=InMemory;DatabaseConfiguration__EventLogContext__Host=localhost;DatabaseConfiguration__EventLogContext__Database=swagger-export;DatabaseConfiguration__EventLogContext__RunMigrations=false;DatabaseConfiguration__IdentityContext__DBType=InMemory;DatabaseConfiguration__IdentityContext__Host=localhost;DatabaseConfiguration__IdentityContext__Database=swagger-export;DatabaseConfiguration__IdentityContext__RunMigrations=false" />
  </Target>

</Project>
