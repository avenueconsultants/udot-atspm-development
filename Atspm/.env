DatabaseConfiguration__AggregationContext__Options__Keepalive=30
DatabaseConfiguration__AggregationContext__Options__Pooling=true
DatabaseConfiguration__AggregationContext__Options__Timeout=30
DatabaseConfiguration__EventLogContext__DBType=PostgreSQL
