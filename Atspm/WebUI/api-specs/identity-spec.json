    "/api/ApiKey/create": {
      "post": {
        "tags": [
          "ApiKey"
        ],
        "summary": "Generates and stores a new API key for the authenticated user.",
        "operationId": "ApiKeyCreate",
        "requestBody": {
          "description": "The details for the new API key.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateApiKeyDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateApiKeyDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateApiKeyDto"
              }
            }
          }
        },
        "responses": {
          "406": {
            "description": "Not Acceptable"
          },
          "200": {
            "description": "Returns the generated raw key. Note: This is only shown once."
          },
          "401": {
            "description": "Unauthorized if the user identity cannot be resolved."
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden if the user attempts to grant claims they do not possess.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/ApiKey/my-keys": {
      "get": {
        "tags": [
          "ApiKey"
        ],
        "summary": "Retrieves all active, non-revoked API keys belonging to the authenticated user.",
        "operationId": "GetApiKeyMyKeys",
        "responses": {
          "406": {
            "description": "Not Acceptable"
          },
          "200": {
            "description": "Returns the list of keys associated with the user."
          },
          "401": {
            "description": "Unauthorized if the user identity cannot be resolved."
          },
          "403": {
            "description": "Forbidden if the user lacks the required view permission."
          }
        }
      }
    },
    "/api/ApiKey/all-keys": {
      "get": {
        "tags": [
          "ApiKey"
        ],
        "summary": "Retrieves all active, non-revoked API keys in the system.",
        "operationId": "GetApiKeyAllKeys",
        "responses": {
          "406": {
            "description": "Not Acceptable"
          },
          "200": {
            "description": "Returns the complete list of system keys."
          },
          "401": {
            "description": "Unauthorized if the user identity cannot be resolved."
          },
          "403": {
            "description": "Forbidden if the user lacks global view permissions."
          }
        }
      }
    },
    "/api/ApiKey/revoke/{id}": {
      "post": {
        "tags": [
          "ApiKey"
        ],
        "summary": "Marks a specific API key as revoked to prevent further use.",
        "operationId": "GetApiKeyRevokeFromId",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The unique identifier of the API key to revoke.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "406": {
            "description": "Not Acceptable"
          },
          "200": {
            "description": "The key was successfully revoked."
          },
          "401": {
            "description": "Unauthorized if the user identity cannot be resolved."
          },
          "403": {
            "description": "Forbidden if the user lacks the required revoke permission."
          },
          "404": {
            "description": "The key was not found or the user does not own it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error if the database update failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
