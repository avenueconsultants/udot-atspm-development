  "components": {
    "schemas": {
      "ChangePasswordViewModel": {
        "required": [
          "newPassword",
          "resetToken"
        ],
        "type": "object",
        "properties": {
          "newPassword": {
            "minLength": 1,
            "type": "string",
            "format": "password"
          },
          "resetToken": {
            "minLength": 1,
            "type": "string"
          },
          "confirmPassword": {
            "type": "string",
            "format": "password",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ClaimModel": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "value": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ClaimsModel": {
        "type": "object",
        "properties": {
          "claims": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateApiKeyDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Gets or sets a descriptive name for the API key to help identify its purpose.",
            "nullable": true,
            "example": "Internal Integration Service"
          },
          "expiresAt": {
            "type": "string",
            "description": "Gets or sets the optional expiration date and time for the API key. \r\nIf null, the key may be treated as having no expiration, depending on system policy.",
            "format": "date-time",
            "nullable": true
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Gets or sets the list of permissions assigned to this API key.",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Data transfer object used for providing the necessary information to create a new API key."
      },
      "CreateRoleViewModel": {
        "required": [
          "roleName"
        ],
        "type": "object",
        "properties": {
          "roleName": {
            "minLength": 1,
            "type": "string"
          }
        },
